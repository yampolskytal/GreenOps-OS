# Copy to apertus.env (app.py loads it automatically) and fill in your key. Pick ONE block.

# Option A: Public AI (Swiss-backed, free key at https://platform.publicai.co/)
export GREENOPS_LLM_BASE_URL=https://api.publicai.co/v1
export GREENOPS_LLM_MODEL=swiss-ai/apertus-70b-instruct
export GREENOPS_LLM_API_KEY=PASTE_KEY_HERE

# Option B: Hugging Face router (free HF token at https://huggingface.co/settings/tokens)
# export GREENOPS_LLM_BASE_URL=https://router.huggingface.co/v1
# export GREENOPS_LLM_MODEL=swiss-ai/Apertus-v1.5-70B:publicai
# export GREENOPS_LLM_API_KEY=hf_PASTE_TOKEN_HERE

export GREENOPS_LLM_TOOLS=0   # plain JSON reply; safer than function calling on Apertus hosts
